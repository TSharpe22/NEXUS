{
  "name": "nexus",
  "version": "0.1.0",
  "description": "Local-first personal knowledge management",
  "author": "TSharpe22",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "check:migration": "ELECTRON_RUN_AS_NODE=1 electron scripts/check-migration.mjs",
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "check:app": "electron-vite build && xvfb-run -a node scripts/check-app.mjs",
    "check:daily": "electron-vite build && xvfb-run -a node scripts/check-daily.mjs",
    "check": "npm run typecheck && npm run check:migration && npm run check:backup && npm run check:files && npm run check:lock && npm run check:calendar && npm run check:phone && npm run check:app && npm run check:daily",
    "check:backup": "node scripts/check-backup.mjs",
    "icon": "node scripts/make-icon.mjs",
    "dist": "electron-vite build && electron-builder --linux",
    "dist:dir": "electron-vite build && electron-builder --linux dir",
    "update": "npm run dist && sudo dpkg -i dist/nexus_*_amd64.deb",
    "check:files": "node scripts/check-files.mjs",
    "check:lock": "node scripts/check-lock.mjs",
    "check:calendar": "node scripts/check-calendar.mjs",
    "check:learning": "electron-vite build && xvfb-run -a node scripts/check-learning.mjs",
    "check:command": "electron-vite build && xvfb-run -a node scripts/check-command.mjs",
    "check:phone": "electron-vite build && xvfb-run -a node scripts/check-phone.mjs",
    "check:practice": "electron-vite build && xvfb-run -a node scripts/check-practice.mjs",
    "check:theme": "electron-vite build && xvfb-run -a node scripts/check-theme.mjs"
  },
  "dependencies": {
    "@blocknote/ariakit": "^0.55.0",
    "@blocknote/core": "^0.55.0",
    "@blocknote/react": "^0.55.0",
    "@fontsource/chakra-petch": "^5.1.0",
    "@fontsource/ibm-plex-mono": "^5.1.0",
    "@xyflow/react": "^12.11.6",
    "better-sqlite3": "^11.7.0",
    "cmdk": "^1.0.0",
    "fuse.js": "^7.0.0",
    "ical.js": "^2.2.1",
    "marked": "^18.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-hot-toast": "^2.4.1",
    "turndown": "^7.2.4",
    "uuid": "^11.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/turndown": "^5.0.6",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "playwright-core": "^1.49.0",
    "typescript": "^5.6.0"
  }
}
