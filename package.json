{
  "name": "nexus",
  "version": "0.1.0",
  "description": "Local-first personal knowledge management",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "check:migration": "ELECTRON_RUN_AS_NODE=1 electron scripts/check-migration.mjs",
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "check:app": "electron-vite build && xvfb-run -a node scripts/check-app.mjs",
    "check": "npm run typecheck && npm run check:migration && npm run check:backup && npm run check:app",
    "check:backup": "node scripts/check-backup.mjs"
  },
  "dependencies": {
    "@blocknote/ariakit": "^0.24.2",
    "@blocknote/core": "^0.24.0",
    "@blocknote/react": "^0.24.0",
    "@fontsource/chakra-petch": "^5.1.0",
    "@fontsource/ibm-plex-mono": "^5.1.0",
    "better-sqlite3": "^11.7.0",
    "cmdk": "^1.0.0",
    "fuse.js": "^7.0.0",
    "marked": "^18.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-hot-toast": "^2.4.1",
    "turndown": "^7.2.4",
    "uuid": "^11.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/turndown": "^5.0.6",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "playwright-core": "^1.49.0",
    "typescript": "^5.6.0"
  },
  "overrides": {
    "@tiptap/core": "2.11.5",
    "@tiptap/react": "2.11.5",
    "@tiptap/pm": "2.11.5",
    "@tiptap/extension-bold": "2.11.5",
    "@tiptap/extension-bubble-menu": "2.11.5",
    "@tiptap/extension-code": "2.11.5",
    "@tiptap/extension-collaboration": "2.11.5",
    "@tiptap/extension-collaboration-cursor": "2.11.5",
    "@tiptap/extension-floating-menu": "2.11.5",
    "@tiptap/extension-gapcursor": "2.11.5",
    "@tiptap/extension-hard-break": "2.11.5",
    "@tiptap/extension-history": "2.11.5",
    "@tiptap/extension-horizontal-rule": "2.11.5",
    "@tiptap/extension-italic": "2.11.5",
    "@tiptap/extension-link": "2.11.5",
    "@tiptap/extension-paragraph": "2.11.5",
    "@tiptap/extension-strike": "2.11.5",
    "@tiptap/extension-table-cell": "2.11.5",
    "@tiptap/extension-table-header": "2.11.5",
    "@tiptap/extension-table-row": "2.11.5",
    "@tiptap/extension-text": "2.11.5",
    "@tiptap/extension-underline": "2.11.5"
  }
